# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# BOVI ACCESS — client source media
# ---------------------------------------------------------------
# Raw client asset package (HEIC/PNG originals from the client's
# Google Drive) and the bulk JPG conversions. These are large
# (~470MB combined) and are NOT web deliverables. They are the
# working library from which optimised derivatives are produced
# into /public. Originals must be preserved on disk and backed up
# separately — they are deliberately not tracked in git.
/client-assets/raw/
/client-assets/jpg/
# Client-supplied hero footage (13.7MB). The web derivative in
# public/media is generated from it by `npm run assets:video` and IS
# committed; the source is not.
/client-assets/*.MP4
/client-assets/*.mp4
/client-assets/*.MOV
/client-assets/*.mov
# client-assets/selected/ IS tracked — it is the curated shortlist.

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/**/*-snapshots/

# QA artefacts
/qa-screenshots/

# Sanity
/.sanity/
